{
  "name": "@aifcoding/opencode-memory",
  "version": "0.1.0",
  "description": "opencode 本地持久记忆插件：三层记忆（长期知识/情景摘要/会话工作记忆），纯本地 SQLite + jieba 中文检索",
  "type": "module",
  "main": "dist/plugin.js",
  "module": "dist/plugin.js",
  "exports": "./dist/plugin.js",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aifcoding/opencode-memory.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "sqlite",
    "jieba",
    "rag",
    "ai"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun build plugin.ts --outdir dist --target bun --external jieba-wasm --external zod --external jsonc-parser",
    "prepublishOnly": "bun test && bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jieba-wasm": "^2.4.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.5.4"
  }
}
